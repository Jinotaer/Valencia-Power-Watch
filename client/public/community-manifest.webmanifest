{
  "id": "/login",
  "name": "Valencia PowerWatch",
  "short_name": "PowerWatch",
  "description": "Report interruptions, follow outage information and manage field response work in Valencia City.",
  "shortcuts": [
    {
      "name": "Report an outage",
      "url": "/community/submit-report",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Field response jobs",
      "url": "/staff/jobs",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8fb",
  "theme_color": "#24449a",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
